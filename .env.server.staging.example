# Staging Node API secrets (gitignored copy: `.env.server.staging`)
# Used when running `npm run dev:staging` — must match `.env.staging` Supabase project.

SERVER_PORT=4001

SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY_HERE

# eTimeOffice (same credentials as production .env.server)
ETIME_BASE_URL=https://api.etimeoffice.com/api
ETIME_PUNCH_ENDPOINT=DownloadInOutPunchData
ETIME_AUTH_CREDENTIALS=YOUR_ETIME_AUTH_CREDENTIALS_HERE
ETIME_TIMEOUT_MS=60000
ETIME_MERGE_PUNCH_ENDPOINTS=true
ETIME_SYNC_OVERLAP_HOURS=24
ETIME_SYNC_LOOKBACK_DAYS=14
ETIME_SYNC_TIMEZONE=Asia/Kolkata
ETIME_MAX_DAYS_PER_REQUEST=7

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://YOUR_STAGING_HOST:3001
