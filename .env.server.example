# Server-only Whitebooks credentials (DO NOT expose to frontend)
SERVER_PORT=8787
WHITEBOOKS_BASE_URL=https://api.whitebooks.in
WHITEBOOKS_EMAIL=YOUR_WHITEBOOKS_EMAIL_HERE
WHITEBOOKS_USERNAME=YOUR_WHITEBOOKS_USERNAME_HERE
WHITEBOOKS_PASSWORD=YOUR_WHITEBOOKS_PASSWORD_HERE
WHITEBOOKS_IP_ADDRESS=YOUR_WHITEBOOKS_IP_HERE
WHITEBOOKS_CLIENT_ID=YOUR_WHITEBOOKS_CLIENT_ID_HERE
WHITEBOOKS_CLIENT_SECRET=YOUR_WHITEBOOKS_CLIENT_SECRET_HERE
WHITEBOOKS_GSTIN=YOUR_GSTIN_HERE
WHITEBOOKS_FALLBACK_BUYER_PIN=YOUR_BUYER_PIN_HERE
WHITEBOOKS_FALLBACK_BUYER_PIN_STATE_24=YOUR_BUYER_PIN_HERE

# Server-only eTimeOffice credentials (DO NOT expose to frontend)
ETIME_BASE_URL=https://api.etimeoffice.com/api
ETIME_PUNCH_ENDPOINT=DownloadInOutPunchData
ETIME_AUTH_CREDENTIALS=YOUR_ETIME_AUTH_CREDENTIALS_HERE
ETIME_TIMEOUT_MS=60000
# Merge DownloadPunchData + DownloadInOutPunchData (recommended: true)
ETIME_MERGE_PUNCH_ENDPOINTS=true
# Prefer per-punch endpoint first when ETIME_PREFER_GRANULAR_PUNCHES=true
# ETIME_PREFER_GRANULAR_PUNCHES=false
# Overlap sync (POST /api/admin/attendance/sync and optional cron)
ETIME_SYNC_OVERLAP_HOURS=24
ETIME_SYNC_LOOKBACK_DAYS=14
ETIME_SYNC_TIMEZONE=Asia/Kolkata
ETIME_MAX_DAYS_PER_REQUEST=7
# Optional: ETIME_SYNC_SECRET=change-me  (header x-etime-sync-secret)
# ETIME_SYNC_CRON_ENABLED=true
# ETIME_SYNC_INTERVAL_MS=900000

# --- Cloudflare R2 (Software subscriptions invoice uploads only) ---
# S3 API endpoint from R2 dashboard (https://<account_id>.r2.cloudflarestorage.com)

R2_BUCKET=YOUR_R2_BUCKET_HERE
R2_ENDPOINT=https://YOUR_R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_HERE
# Optional: omit R2_BUCKET to use default indus-erp-uploads. "Folders" in R2 are key prefixes (e.g. software-subscriptions/), not separate buckets.
# Uploads go browser -> Node -> R2 (no R2 CORS needed for PUT). For presigned GET opens, add R2 CORS if the browser blocks the download tab.

# --- Supabase (server-only: JWT validation for /api/admin/* including eTime sync) ---
# MUST match the same Supabase project as the website build (VITE_SUPABASE_URL).
# Production website (indus-erp.in): wbyzhknaqcjqqtwopupl — staging: xjzhlbpgnpcmbdlufhwo. Never mix.
# Live check: curl -s https://indus-erp.in/api/health → supabase_project must be wbyzhknaqcjqqtwopupl
# and service_role_key must be "ok". If supabase_project is xjzhlbpgnpcmbdlufhwo, Raw Attendance 401s.
# Do NOT set ERP_ENV=staging on the production API host.
# Staging hosts MUST set ERP_ENV=staging so production auto-pin does not rewrite their URL.
# If SUPABASE_SERVICE_ROLE_KEY is missing or from another project, Sync eTimeOffice returns 401.
# Dashboard → Project Settings → API (service_role is secret — never put in VITE_*).
# Copy the real service_role key into .env.server on the API host. Do not commit real JWTs.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co/
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Comma-separated browser origins allowed to call this API (helmet + CORS).
# Production MUST include https://indus-erp.in — otherwise startup/health checks
# cannot tell this host is production and Raw Attendance sync will misconfigure.
CORS_ORIGINS=http://localhost:5173,http://YOUR_STAGING_HOST:3001,https://YOUR_PRODUCTION_DOMAIN

# Optional alternate filenames (repo root): .envserver, .env.local — all merged; non-empty values win over empty placeholders.
